# Caminho de armazenamento local. Por padrão ./storage, relativo ao diretório do projeto.
AUTOCLIPS_HOME=./storage
# CPU: small ou base; CPU int8. Para precisão melhor, medium com GPU.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Habilite somente se a obtenção de conteúdo audiovisual via YouTube estiver
# explicitamente autorizada pela plataforma (aprovação prévia por escrito) e pelo titular.
ALLOW_YOUTUBE_IMPORT=false
# Ative apenas para importar fontes com uso e obtenção autorizados.
# AUTOCLIPS_MAX_UPLOAD_BYTES=188743680
# YT_DLP_NODE_PATH=/usr/local/bin/node
# Segredos OAuth são arquivos LOCAIS; não os disponibilize no MCP.
GOOGLE_CLIENT_SECRETS=./client_secret.json
GOOGLE_TOKEN_FILE=./token.json

# Deployment HTTP: mínimo 32 caracteres aleatórios (NUNCA publique em GitHub)
# MCP_GATEWAY_TOKEN=COLE_AQUI_UM_SEGREDO_GERADO_COM_64_HEX
# Em Railway: crie Volume e monte em /data.
# AUTOCLIPS_HOME=/data

# Railway: OAuth Web seguro + autorização apenas do canal ClipCon
# Configure os valores secretos DIRETAMENTE no Railway; não copie Client Secret em arquivos Git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://autoclips-worker-production.up.railway.app/oauth/youtube/callback
YOUTUBE_EXPECTED_CHANNEL_ID=
# Os tokens ficam criptografados no volume AUTOCLIPS_HOME e vinculados
# ao MCP_GATEWAY_TOKEN. Não troque MCP_GATEWAY_TOKEN sem reconectar o YouTube.
