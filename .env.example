# Caminho de armazenamento local. Por padrão ./storage, relativo ao diretório do projeto.
AUTOCLIPS_HOME=./storage
# CPU: small ou base; CPU int8. Para precisão melhor, medium com GPU.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Habilite somente se a obtenção de conteúdo audiovisual via YouTube estiver
# explicitamente autorizada pela plataforma (aprovação prévia por escrito) e pelo titular.
ALLOW_YOUTUBE_IMPORT=false
# Segredos OAuth são arquivos LOCAIS; não os disponibilize no MCP.
GOOGLE_CLIENT_SECRETS=./client_secret.json
GOOGLE_TOKEN_FILE=./token.json

# Deployment HTTP: mínimo 32 caracteres aleatórios (NUNCA publique em GitHub)
# MCP_GATEWAY_TOKEN=COLE_AQUI_UM_SEGREDO_GERADO_COM_64_HEX
# Em Railway: crie Volume e monte em /data.
# AUTOCLIPS_HOME=/data
